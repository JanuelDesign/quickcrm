rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Contactos collection & audit trail subcollection
    match /contactos/{contactoId} {
      allow read, write: if true;

      // Subcollection for automatic background action auditing
      match /historialAcciones/{accionId} {
        allow read, write: if true;
      }
    }

    // Root collection for deleted contacts registry
    match /registroEliminaciones/{eliminacionId} {
      allow read, write: if true;
    }

    // Usuarios collection - Permissions & Role Management
    match /usuarios/{usuarioId} {
      allow read, write: if true;
    }
  }
}

